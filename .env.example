# Export values in your own terminal; this project does not read .env files automatically.
# Never commit real keys. The application reads the process environment only.
DEEPSEEK_API_KEY=
# Default model verified against provider documentation on 2026-09-07.
LLM_MODEL=deepseek-v4-flash
# Optional compatible provider: specify BOTH its URL and its own key explicitly.
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# Optional host paths; defaults are .runtime/runs.sqlite3 and .runtime/business.sqlite3.
# AGENT_AUDIT_PATH=.runtime/runs.sqlite3
# AGENT_BUSINESS_PATH=.runtime/business.sqlite3
# Retrieval defaults to lexical; this default needs no model download or key.
# Optional semantic/hybrid: install the semantic extra and prepare model files explicitly.
# AGENT_RETRIEVAL_BACKEND=lexical
# AGENT_EMBEDDING_MODEL_DIR=.runtime/models/bge-small-zh-v1.5
# V2 request mode defaults to demo; LLM keys are separate from local embedding inference.
# Docker: pass a local .env using --env-file .env; never COPY it into the image.
